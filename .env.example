# Anthropic API credentials and generation settings
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Local embedding and retrieval settings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVAL_K=5
RETRIEVAL_MAX_K=20
RETRIEVAL_MIN_SIMILARITY=0.0

# Input validation and local storage
MAX_QUESTION_LENGTH=1000
CHROMA_PATH=chroma_db
REGULATION_PATH=data/raw/regulation_es.html
EVALUATION_DATASET_PATH=data/eval/questions.jsonl
EVALUATION_RESULTS_PATH=evals/results
LOG_LEVEL=INFO
